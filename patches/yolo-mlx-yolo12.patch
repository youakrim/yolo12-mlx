     return p
 
 
+
+_DW_OPS = {}
+
+
+def _dw_op(k: int, c: int):
+    """Depthwise conv with a faster weight gradient (MLX's native one is ~30x its forward)."""
+    key = (k, c)
+    if key in _DW_OPS:
+        return _DW_OPS[key]
+    p = k // 2
+
+    @mx.custom_function
+    def f(x, w):
+        return mx.conv2d(x, w, padding=p, groups=c)
+
+    @f.vjp
+    def f_vjp(primals, cot, out):
+        x, w = primals
+        cot = cot.astype(x.dtype)
+        dx = mx.conv2d(cot, w[:, ::-1, ::-1, :], padding=p, groups=c)
+        h, wd = x.shape[1:3]
+        xp = mx.pad(x, [(0, 0), (p, p), (p, p), (0, 0)])
+        rows = [
+            mx.stack([(xp[:, i : i + h, j : j + wd, :] * cot).sum(axis=(0, 1, 2)) for j in range(k)], axis=0)
+            for i in range(k)
+        ]
+        dw = mx.transpose(mx.stack(rows, axis=0), (2, 0, 1))[..., None]
+        return dx.astype(x.dtype), dw.astype(w.dtype)
+
+    _DW_OPS[key] = f
+    return f
+
